<service name="rallymaster" package="com.rallyapp.rallymaster"
	multitenant="true">

	<tenant-discriminator name="organizationId" type="long" />

	<entity name="organization" db-name="organization" persistence="true">
		<attribute name="name" type="string" db-name="name" />

		<related name="organizationMemberships" relationship="one_to_many"
			entity="organizationMembership" collection="set"
			mapped-by="organization" api-reference="none" />

		<finder unique="true">
			<finder-attribute name="name" />
		</finder>

		<api>
			<external operations="CREATE READ UPDATE DELETE" />
		</api>
	</entity>

	<entity name="organizationMembership" db-name="organization_membership"
		persistence="true" multitenant="true">
		<attribute name="role" type="enum"
			enum-values="ADMIN,RALLYMASTER,VIEWER" />

		<related name="user" relationship="many_to_one" entity="user"
			api-reference="id" />
		<related name="organization" relationship="many_to_one"
			entity="organization" api-reference="id" />

		<finder tenant-scoped="false">
			<finder-attribute name="user" />
		</finder>

		<finder unique="true">
			<finder-attribute name="user" />
		</finder>

		<api>
			<external operations="CREATE READ UPDATE DELETE" />
		</api>
	</entity>

	<entity name="rally" db-name="rally" multitenant="true">
		<attribute name="name" type="string" />
		<attribute name="description" type="string" />
		<attribute name="date" type="date" />

		<related name="user" relationship="one_to_one" entity="user"
			api-reference="id" />

		<related name="routes" entity="route" relationship="one_to_many"
			collection="list" mapped-by="rally" api-reference="none" />
		
		<api>
			<external operations="CREATE READ UPDATE DELETE" />
		</api>
	</entity>

	<entity name="route" db-name="route" multitenant="true">
		<attribute name="name" type="string" />
		<attribute name="description" type="string" />
		<attribute name="status" type="enum" enum-values="PLANNING,ACTIVE,COMPLETED" />
		<!-- Editable copies of the rally defaults used while this route is planned. -->
		<attribute name="defaultSpeed" type="double" />
		<attribute name="restartIntervalMillis" type="long" />
		<attribute name="defaultPauseDurationMillis" type="long" />
		<!-- Route-specific competition schedule values. -->
		<attribute name="timeZone" type="string" />
		<attribute name="carZeroStartEpochMillis" type="long" />
		<attribute name="maximumCheckpointScore" type="long" />

		<related name="rally" entity="rally" relationship="many_to_one"
			api-reference="id" />

		<related name="items" entity="routeItem" relationship="one_to_many"
			collection="list" mapped-by="route" api-reference="none" />
		<related name="timingPlan" entity="routeTimingPlan" relationship="one_to_one"
			mapped-by="route" api-reference="none" />

		<api>
			<external operations="CREATE READ UPDATE DELETE" />
		</api>
	</entity>

	<!--
		Private event configuration shared by every route in a rally. This entity
		has no external API: eventPasswordHash must never be returned to a client.
	-->
	<entity name="rallyConfiguration" db-name="rally_configuration"
		multitenant="true">
		<attribute name="distanceUnit" type="enum" enum-values="MILES,KILOMETERS" />
		<attribute name="scoringUnit" type="enum" enum-values="SECONDS,CENTS" />
		<attribute name="eventPasswordHash" type="string" />
		<attribute name="timeZone" type="string" />
		<!-- UTC instant retained in milliseconds for precise car-zero calculations. -->
		<attribute name="officialStartEpochMillis" type="long" />
		<attribute name="checkpointAcquisitionRadiusMeters" type="double" />
		<attribute name="maximumCheckpointScore" type="long" />
		<!-- Rally-wide only; routes may not override the car start interval. -->
		<attribute name="carStartIntervalMillis" type="long" />
		<attribute name="defaultSpeed" type="double" />
		<attribute name="defaultRestartIntervalMillis" type="long" />
		<attribute name="defaultPauseDurationMillis" type="long" />

		<related name="rally" entity="rally" relationship="one_to_one"
			api-reference="id" />

		<finder unique="true">
			<finder-attribute name="rally" />
		</finder>
	</entity>

	<!-- Immutable server-calculated car-zero plan created when a route is published. -->
	<entity name="routeTimingPlan" db-name="route_timing_plan" multitenant="true">
		<attribute name="version" type="long" />
		<attribute name="carZeroStartEpochMillis" type="long" />
		<attribute name="distanceUnit" type="enum" enum-values="MILES,KILOMETERS" />
		<attribute name="scoringUnit" type="enum" enum-values="SECONDS,CENTS" />

		<related name="route" entity="route" relationship="one_to_one" api-reference="none" />
		<related name="points" entity="routeTimingPoint" relationship="one_to_many"
			collection="list" mapped-by="routeTimingPlan" api-reference="none" />

		<finder unique="true">
			<finder-attribute name="route" />
		</finder>
	</entity>

	<!-- Calculated timing evidence for each route item in a published plan. -->
	<entity name="routeTimingPoint" db-name="route_timing_point" multitenant="true">
		<attribute name="segmentNumber" type="long" />
		<attribute name="segmentOffsetMillis" type="long" />
		<attribute name="carZeroSegmentStartEpochMillis" type="long" />
		<attribute name="carZeroIdealArrivalEpochMillis" type="long" />

		<related name="routeTimingPlan" entity="routeTimingPlan" relationship="many_to_one"
			api-reference="none" />
		<related name="routeItem" entity="routeItem" relationship="many_to_one"
			api-reference="none" />

		<finder unique="true">
			<finder-attribute name="routeTimingPlan" />
			<finder-attribute name="routeItem" />
		</finder>
	</entity>

	<!-- A registered competitor team for one selected rally route. The public
		competition API creates these records after password authentication. -->
	<entity name="rallyEntry" db-name="rally_entry" multitenant="true">
		<attribute name="driverFirstName" type="string" />
		<attribute name="driverLastName" type="string" />
		<attribute name="navigatorFirstName" type="string" />
		<attribute name="navigatorLastName" type="string" />
		<attribute name="carNumber" type="long" />
		<attribute name="primaryDeviceId" type="string" />
		<attribute name="backupDeviceId" type="string" />

		<related name="rally" entity="rally" relationship="many_to_one"
			api-reference="id" />
		<related name="route" entity="route" relationship="many_to_one"
			api-reference="id" />

		<finder unique="true">
			<finder-attribute name="rally" />
			<finder-attribute name="carNumber" />
		</finder>

		<finder unique="true">
			<finder-attribute name="rally" />
			<finder-attribute name="primaryDeviceId" />
		</finder>
	</entity>

	<!-- Immutable diagnostic evidence for a competitor's completed checkpoint intercept. -->
	<entity name="competitorTelemetry" db-name="competitor_telemetry"
		multitenant="true">
		<attribute name="occurredAt" type="datetime" />
		<attribute name="interceptLatitude" type="double" />
		<attribute name="interceptLongitude" type="double" />
		<attribute name="interceptHeading" type="double" />
		<attribute name="interceptSpeed" type="double" />
		<attribute name="interceptAccuracy" type="double" />
		<attribute name="closestDistanceMeters" type="double" />

		<related name="rallyEntry" entity="rallyEntry" relationship="many_to_one"
			api-reference="none" />
		<related name="route" entity="route" relationship="many_to_one"
			api-reference="none" />
		<related name="checkpoint" entity="checkpoint" relationship="many_to_one"
			api-reference="none" />
		<related name="data" entity="competitorTelemetryData" relationship="one_to_many"
			collection="list" mapped-by="competitorTelemetry" api-reference="none" />

		<!-- Makes one primary-device intercept upload idempotent. -->
		<finder unique="true">
			<finder-attribute name="rallyEntry" />
			<finder-attribute name="checkpoint" />
			<finder-attribute name="occurredAt" />
		</finder>
	</entity>

	<!-- One raw GPS/sensor reading captured inside a checkpoint acquisition radius. -->
	<entity name="competitorTelemetryData" db-name="competitor_telemetry_data"
		multitenant="true">
		<attribute name="capturedAt" type="datetime" />
		<attribute name="latitude" type="double" />
		<attribute name="longitude" type="double" />
		<attribute name="heading" type="double" />
		<attribute name="speed" type="double" />
		<attribute name="accuracy" type="double" />
		<attribute name="distanceToCheckpointMeters" type="double" />

		<related name="competitorTelemetry" entity="competitorTelemetry"
			relationship="many_to_one" api-reference="none" />
	</entity>

	<entity name="routeItem" db-name="route_item" abstract="true" multitenant="true">
		<!-- Useful as a discriminator for clients and API payloads. -->
		<attribute name="itemType" type="enum" enum-values="NRI,CHECKPOINT" />

		<!-- The one canonical order across both item types. -->
		<attribute name="position" type="long" />

	    <attribute name="latitude" type="double" />
	    <attribute name="longitude" type="double" />
	    <attribute name="heading" type="int" />
	    <attribute name="distance" type="double" />
		<attribute name="notes" type="string" />
		
	    <attribute name="deleted" type="boolean" />

		<related name="route" entity="route" relationship="many_to_one"
			api-reference="id" />

		<finder>
			<finder-attribute name="route" />
		</finder>

	</entity>

	<entity name="routeInstruction" db-name="route_instruction"	parent="routeItem" discriminator-value="NRI">
	    <attribute name="instructionNumber" type="long" />
		<attribute name="instructionText" type="string" />
		<attribute name="instructionType" type="enum"
			enum-values="STANDARD,BEGIN_FREE_ZONE,END_FREE_ZONE,BEGIN_TRANSIT,END_TRANSIT" />
		<attribute name="speed" type="double" />
		<attribute name="pauseDurationMillis" type="long" />
		<attribute name="transitDurationMillis" type="long" />

		<api>
			<external operations="CREATE READ UPDATE DELETE" />
		</api>
	</entity>

	<entity name="checkpoint" db-name="checkpoint" parent="routeItem" discriminator-value="CHECKPOINT">
		<attribute name="checkpointNumber" type="long" />
		<attribute name="checkpointType" type="enum" enum-values="OFFCOURSE_CONTROL,TIMED_CONTROL,TIME_CHECK,RESTART,START,FINISH" />
		<attribute name="name" type="string" />

		<api>
			<external operations="CREATE READ UPDATE DELETE" />
		</api>
	</entity>

	<entity name="user" db-name="user_">
		<attribute name="emailAddress" type="string" />
		<attribute name="firstName" type="string" />
		<attribute name="lastName" type="string" />

		<related name="memberships" relationship="one_to_many"
			entity="organizationMembership" collection="set" mapped-by="user"
			api-reference="none" />

		<finder unique="true">
			<finder-attribute name="emailAddress" />
		</finder>
	</entity>

</service>
